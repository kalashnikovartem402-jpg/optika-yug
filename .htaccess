# ==============================================================================
# SENIOR DEPLOY-READY APACHE CONFIGURATION (.htaccess)
# Салон оптики «Оптика Юг»
# ==============================================================================

# 1. Кодировка по умолчанию UTF-8
AddDefaultCharset UTF-8
DefaultLanguage ru-RU

# 2. Защита служебных файлов
<FilesMatch "^(\.ht|\.git|\.env|leads\.log)">
    Order allow,deny
    Deny from all
</FilesMatch>

# 3. Включение сжатия Gzip / Deflate
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/ttf
    AddOutputFilterByType DEFLATE font/otf
    AddOutputFilterByType DEFLATE font/woff
    AddOutputFilterByType DEFLATE font/woff2
</IfModule>

# 4. Кэширование статических ресурсов (Browser Caching)
<IfModule mod_expires.c>
    ExpiresActive On
    
    # Изображения (1 год)
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # Шрифты (1 год)
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"

    # Стили и Скрипты (1 месяц)
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"

    # HTML (без жесткого кэширования для оперативных обновлений)
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    # Кэширование статики
    <FilesMatch "\.(ico|pdf|flv|jpg|jpeg|png|gif|webp|js|css|swf|svg|woff|woff2|ttf|eot)$">
        Header set Cache-Control "max-age=31536000, public"
    </FilesMatch>
    
    # Базовые заголовки безопасности
    Header set X-Content-Type-Options "nosniff"
    Header set X-XSS-Protection "1; mode=block"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# 5. Маршрутизация и перенаправления
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Если запрошен существующий файл или папка — отдаем напрямую
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Обработка send.php
    RewriteRule ^send\.php$ send.php [L]

    # Все остальные запросы направляем на index.html
    RewriteRule ^ index.html [L]
</IfModule>
